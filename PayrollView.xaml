<UserControl x:Class="GestionBibliotheque.PayrollView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="220" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Text="Kòmanse" /><TextBox Margin="6,0,10,0" Width="95" Padding="6" Text="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" /><TextBlock VerticalAlignment="Center" Text="Fini" /><TextBox Margin="6,0,10,0" Width="95" Padding="6" Text="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}" /><TextBlock VerticalAlignment="Center" Text="Peye" /><TextBox Margin="6,0,10,0" Width="95" Padding="6" Text="{Binding PayDate, UpdateSourceTrigger=PropertyChanged}" /><Button Padding="12,7" Content="Kreye peryòd" Command="{Binding CreateCommand}" /></StackPanel>
        <DataGrid Grid.Row="1" Margin="0,14,0,14" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Kòmanse" Binding="{Binding StartDate, StringFormat=yyyy-MM-dd}" /><DataGridTextColumn Header="Fini" Binding="{Binding EndDate, StringFormat=yyyy-MM-dd}" /><DataGridTextColumn Header="Dat peman" Binding="{Binding PayDate, StringFormat=yyyy-MM-dd}" /><DataGridTextColumn Header="Estati" Binding="{Binding Status}" /></DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="2"><StackPanel Orientation="Horizontal"><Button Padding="10,7" Content="Kalkile" Command="{Binding CalculateCommand}" /><Button Margin="6,0,0,0" Padding="10,7" Content="Revize" Command="{Binding ReviewCommand}" /><Button Margin="6,0,0,0" Padding="10,7" Content="Apwouve" Command="{Binding ApproveCommand}" /><Button Margin="6,0,0,0" Padding="10,7" Content="Make peye" Command="{Binding PayCommand}" /><Button Margin="6,0,0,0" Padding="10,7" Content="Fèmen" Command="{Binding CloseCommand}" /><Button Margin="6,0,0,0" Padding="10,7" Content="Payslip" Command="{Binding ViewPayslipCommand}" /></StackPanel><DataGrid Margin="0,12,0,0" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Employee" Binding="{Binding Employee.FullName}" Width="*" /><DataGridTextColumn Header="Baz" Binding="{Binding BaseSalary, StringFormat=N2}" /><DataGridTextColumn Header="Gross" Binding="{Binding GrossAmount, StringFormat=N2}" /><DataGridTextColumn Header="Tax" Binding="{Binding EmployeeTaxAmount, StringFormat=N2}" /><DataGridTextColumn Header="Dediksyon" Binding="{Binding EmployeeDeductionAmount, StringFormat=N2}" /><DataGridTextColumn Header="Net" Binding="{Binding NetAmount, StringFormat=N2}" /></DataGrid.Columns></DataGrid><TextBlock Margin="0,12,0,0" Foreground="#657477" Text="{Binding PayslipSummary}" TextWrapping="Wrap" /><TextBlock Margin="0,8,0,0" Foreground="#657477" Text="{Binding Message}" TextWrapping="Wrap" /></StackPanel>
    </Grid>
</UserControl>
