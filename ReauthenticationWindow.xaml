<Window x:Class="GestionBibliotheque.ReauthenticationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Re-antre modpas" Height="250" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Konfime idantite w" />
            <TextBlock x:Name="PurposeTextBlock" Margin="0,8,0,12" Foreground="#657477"
                       Text="Pou apwouve payroll sa a, antre modpas kont ou ankò." TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="UsernameTextBlock" />
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,8" Padding="8"
                         AutomationProperties.Name="Modpas pou konfime idantite" />
            <TextBlock x:Name="MessageTextBlock" Foreground="#B42318" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="14,8" Content="Anile" Click="CancelButton_Click" />
            <Button x:Name="ConfirmButton" Margin="8,0,0,0" Padding="14,8" Content="Konfime"
                    IsDefault="True" Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</Window>
