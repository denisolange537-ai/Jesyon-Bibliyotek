<Window x:Class="GestionBibliotheque.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chanje modpas" Height="430" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Chanje modpas" />
            <TextBlock x:Name="ForcedMessageTextBlock" Margin="0,8,0,16" Foreground="#8A4B00"
                       Text="Pou sekirite, antre modpas aktyèl la epi chwazi yon nouvo modpas." TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Modpas aktyèl oswa tanporè" />
            <PasswordBox x:Name="CurrentPasswordBox" Margin="0,5,0,12" Padding="8" AutomationProperties.Name="Modpas aktyèl" />
            <TextBlock Text="Nouvo modpas (omwen 12 karaktè)" />
            <PasswordBox x:Name="NewPasswordBox" Margin="0,5,0,12" Padding="8" AutomationProperties.Name="Nouvo modpas" />
            <TextBlock Text="Konfime nouvo modpas la" />
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,5,0,12" Padding="8" AutomationProperties.Name="Konfime nouvo modpas" />
            <TextBlock x:Name="MessageTextBlock" Foreground="#B42318" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Padding="14,8" Content="Anile" Click="CancelButton_Click" />
            <Button Margin="8,0,0,0" Padding="14,8" Content="Anrejistre" IsDefault="True" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
