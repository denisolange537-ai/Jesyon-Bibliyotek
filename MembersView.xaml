<UserControl x:Class="GestionBibliotheque.MembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Padding="14,7" Content="Nouvo manm" Command="{Binding NewCommand}" />
            <TextBox Width="280" Padding="8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Margin="8,0,0,0" Padding="14,7" Content="Chèche" Command="{Binding SearchCommand}" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nimewo" Binding="{Binding MemberNumber}" Width="110" />
                    <DataGridTextColumn Header="Non" Binding="{Binding FirstName}" Width="*" />
                    <DataGridTextColumn Header="Siyati" Binding="{Binding LastName}" Width="*" />
                    <DataGridTextColumn Header="Imèl" Binding="{Binding Email}" Width="170" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Padding="18" BorderBrush="#D9D3C8" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Detay manm" />
                        <TextBlock Margin="0,16,0,4" Text="Nimewo manm" /><TextBox Padding="7" Text="{Binding MemberNumber, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,4" Text="Non" /><TextBox Padding="7" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,4" Text="Siyati" /><TextBox Padding="7" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,4" Text="Imèl" /><TextBox Padding="7" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,4" Text="Telefòn" /><TextBox Padding="7" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,4" Text="Adrès" /><TextBox Padding="7" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,18,0,0" Orientation="Horizontal"><Button Padding="14,8" Content="Sove" Command="{Binding SaveCommand}" /><Button Margin="8,0,0,0" Padding="14,8" Content="Dezaktive" Command="{Binding DeactivateCommand}" /></StackPanel>
                        <TextBlock Margin="0,14,0,0" Foreground="#657477" Text="{Binding Message}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
