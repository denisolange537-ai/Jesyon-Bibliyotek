<UserControl x:Class="GestionBibliotheque.BorrowingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Padding="18" BorderBrush="#D9D3C8" BorderThickness="1" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Nouvo prete" />
                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                    <StackPanel Width="260"><TextBlock Text="Liv" /><ComboBox Margin="0,5,12,0" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" DisplayMemberPath="Title" /></StackPanel>
                    <StackPanel Width="260"><TextBlock Text="Manm" /><ComboBox Margin="0,5,12,0" ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}" DisplayMemberPath="MemberNumber" /></StackPanel>
                    <Button Margin="0,20,0,0" Padding="14,7" Content="Anrejistre prete" Command="{Binding BorrowCommand}" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0" Foreground="#657477" Text="{Binding Message}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding OpenBorrowings}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Liv" Binding="{Binding BookTitle}" Width="*" />
                <DataGridTextColumn Header="Manm" Binding="{Binding MemberName}" Width="*" />
                <DataGridTextColumn Header="Dat prete" Binding="{Binding BorrowedAtUtc, StringFormat=d}" Width="130" />
                <DataGridTextColumn Header="Dat retou" Binding="{Binding DueAtUtc, StringFormat=d}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
