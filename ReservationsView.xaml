<UserControl x:Class="GestionBibliotheque.ReservationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Padding="18" Margin="0,0,0,16" BorderBrush="#D9D3C8" BorderThickness="1"><StackPanel><TextBlock FontSize="20" FontWeight="SemiBold" Text="Nouvo reservation" /><StackPanel Margin="0,14,0,0" Orientation="Horizontal"><StackPanel Width="280"><TextBlock Text="Liv" /><ComboBox Margin="0,5,12,0" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" DisplayMemberPath="Title" /></StackPanel><StackPanel Width="220"><TextBlock Text="Manm" /><ComboBox Margin="0,5,12,0" ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}" DisplayMemberPath="MemberNumber" /></StackPanel><Button Margin="0,20,0,0" Padding="14,7" Content="Rezève" Command="{Binding ReserveCommand}" /></StackPanel><TextBlock Margin="0,12,0,0" Foreground="#657477" Text="{Binding Message}" /></StackPanel></Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedReservation}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Liv" Binding="{Binding BookTitle}" Width="*" /><DataGridTextColumn Header="Manm" Binding="{Binding MemberName}" Width="*" /><DataGridTextColumn Header="Kreye" Binding="{Binding CreatedAtUtc, StringFormat=d}" Width="140" /></DataGrid.Columns><DataGrid.ContextMenu><ContextMenu><MenuItem Header="Anile" Command="{Binding PlacementTarget.DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /></ContextMenu></DataGrid.ContextMenu></DataGrid>
        <Button Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Padding="14,7" Content="Anile seleksyon" Command="{Binding CancelCommand}" />
    </Grid>
</UserControl>
