<UserControl x:Class="GestionBibliotheque.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Padding="14,7" Content="Rafrechi" Command="{Binding RefreshCommand}" /><TextBlock FontSize="20" FontWeight="SemiBold" Text="Rapò bibliyotèk" /></DockPanel>
        <UniformGrid Grid.Row="1" Columns="4" Rows="2" Margin="0,0,0,18">
            <TextBlock Margin="0,0,12,8" Text="Liv aktif: " /><TextBlock Margin="0,0,12,8" Text="{Binding ActiveBooks}" />
            <TextBlock Margin="0,0,12,8" Text="Kopi disponib: " /><TextBlock Margin="0,0,12,8" Text="{Binding AvailableCopies}" />
            <TextBlock Margin="0,0,12,8" Text="Manm aktif: " /><TextBlock Margin="0,0,12,8" Text="{Binding ActiveMembers}" />
            <TextBlock Margin="0,0,12,8" Text="Prete ouvè: " /><TextBlock Margin="0,0,12,8" Text="{Binding OpenBorrowings}" />
            <TextBlock Margin="0,0,12,8" Text="Prete anreta: " /><TextBlock Margin="0,0,12,8" Text="{Binding OverdueBorrowings}" />
            <TextBlock Margin="0,0,12,8" Text="Amann ki poko peye: " /><TextBlock Margin="0,0,12,8" Text="{Binding OutstandingFines, StringFormat={}{0:0.00}}" />
            <TextBlock Margin="0,0,12,8" Text="Rezèvasyon ouvè: " /><TextBlock Margin="0,0,12,8" Text="{Binding OpenReservations}" />
            <TextBlock Margin="0,0,12,8" Foreground="{DynamicResource MutedText}" Text="{Binding Message}" />
        </UniformGrid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding OverdueItems}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns><DataGridTextColumn Header="Liv" Binding="{Binding BookTitle}" /><DataGridTextColumn Header="Manm" Binding="{Binding MemberName}" /><DataGridTextColumn Header="Dat limit" Binding="{Binding DueAtUtc, StringFormat={}{0:dd/MM/yyyy}}" /><DataGridTextColumn Header="Jou anreta" Binding="{Binding DaysOverdue}" /></DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>