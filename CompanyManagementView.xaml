<UserControl x:Class="GestionBibliotheque.CompanyManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Company" />
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Non legal" /><TextBox Padding="7" Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,8,0,0" Text="Non komèsyal" /><TextBox Padding="7" Text="{Binding CommercialName, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,8,0,0" Text="NIF" /><TextBox Padding="7" Text="{Binding TaxIdentificationNumber, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,8,0,0" Text="Nimewo enskripsyon" /><TextBox Padding="7" Text="{Binding RegistrationNumber, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,8,0,0" Text="Adrès" /><TextBox Padding="7" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Vil" /><TextBox Padding="7" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,8,0,0" Text="Depatman/Region" /><TextBox Padding="7" Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,8,0,0" Text="Peyi" /><TextBox Padding="7" Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,8,0,0" Text="Telefòn" /><TextBox Padding="7" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,8,0,0" Text="Imèl" /><TextBox Padding="7" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
            <Button Margin="0,12,0,20" Padding="14,8" HorizontalAlignment="Left" Content="Anrejistre Company" Command="{Binding SaveCompanyCommand}" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock FontSize="18" FontWeight="SemiBold" Text="Depatman" /><DataGrid Margin="0,8,0,8" Height="170" ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Kòd" Binding="{Binding Code}" /><DataGridTextColumn Header="Non" Binding="{Binding Name}" /></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><TextBox Width="90" Padding="6" Text="{Binding DepartmentCode, UpdateSourceTrigger=PropertyChanged}" /><TextBox Margin="6,0,0,0" Width="150" Padding="6" Text="{Binding DepartmentName, UpdateSourceTrigger=PropertyChanged}" /><Button Margin="6,0,0,0" Padding="10,6" Content="Ajoute" Command="{Binding SaveDepartmentCommand}" /></StackPanel><Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Dezaktive" Command="{Binding DeactivateDepartmentCommand}" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock FontSize="18" FontWeight="SemiBold" Text="Post" /><DataGrid Margin="0,8,0,8" Height="170" ItemsSource="{Binding Positions}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Kòd" Binding="{Binding Code}" /><DataGridTextColumn Header="Non" Binding="{Binding Name}" /></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><TextBox Width="90" Padding="6" Text="{Binding PositionCode, UpdateSourceTrigger=PropertyChanged}" /><TextBox Margin="6,0,0,0" Width="150" Padding="6" Text="{Binding PositionName, UpdateSourceTrigger=PropertyChanged}" /><Button Margin="6,0,0,0" Padding="10,6" Content="Ajoute" Command="{Binding SavePositionCommand}" /></StackPanel><Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Dezaktive" Command="{Binding DeactivatePositionCommand}" /></StackPanel></Grid>
            <TextBlock Margin="0,16,0,0" Foreground="#657477" Text="{Binding Message}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
