<UserControl x:Class="GestionBibliotheque.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Padding="14,7" Content="Rafrechi" Command="{Binding RefreshCommand}" /><StackPanel><TextBlock FontSize="20" FontWeight="SemiBold" Text="Rezime bibliyotèk" /><TextBlock Foreground="{DynamicResource MutedText}" Text="{Binding CurrentEmployee.FullName}" /><TextBlock Foreground="{DynamicResource MutedText}" Text="{Binding CurrentEmployee.JobTitle}" /></StackPanel></DockPanel>
        <UniformGrid Grid.Row="1" Columns="2" Rows="3">
            <Border Margin="0,0,12,12" Padding="20" Background="{DynamicResource PanelBackground}" BorderBrush="#D9D3C8" BorderThickness="1"><StackPanel><TextBlock Foreground="{DynamicResource MutedText}" Text="Liv aktif" /><TextBlock Margin="0,8,0,0" FontSize="32" Foreground="{DynamicResource PrimaryText}" Text="{Binding ActiveBooks}" /></StackPanel></Border>
            <Border Margin="0,0,0,12" Padding="20" Background="{DynamicResource PanelBackground}" BorderBrush="#D9D3C8" BorderThickness="1"><StackPanel><TextBlock Foreground="{DynamicResource MutedText}" Text="Manm aktif" /><TextBlock Margin="0,8,0,0" FontSize="32" Foreground="{DynamicResource PrimaryText}" Text="{Binding ActiveMembers}" /></StackPanel></Border>
            <Border Margin="0,0,12,12" Padding="20" Background="{DynamicResource PanelBackground}" BorderBrush="#D9D3C8" BorderThickness="1"><StackPanel><TextBlock Foreground="{DynamicResource MutedText}" Text="Prete ouvè" /><TextBlock Margin="0,8,0,0" FontSize="32" Foreground="{DynamicResource PrimaryText}" Text="{Binding OpenBorrowings}" /></StackPanel></Border>
            <Border Margin="0,0,0,12" Padding="20" Background="{DynamicResource PanelBackground}" BorderBrush="#D9D3C8" BorderThickness="1"><StackPanel><TextBlock Foreground="{DynamicResource MutedText}" Text="Prete anreta" /><TextBlock Margin="0,8,0,0" FontSize="32" Foreground="{DynamicResource PrimaryText}" Text="{Binding OverdueBorrowings}" /></StackPanel></Border>
            <Border Grid.ColumnSpan="2" Padding="20" Background="{DynamicResource PanelBackground}" BorderBrush="#D9D3C8" BorderThickness="1"><StackPanel><TextBlock Foreground="{DynamicResource MutedText}" Text="Amann ki poko peye" /><TextBlock Margin="0,8,0,0" FontSize="32" Foreground="{DynamicResource PrimaryText}" Text="{Binding OutstandingFines, StringFormat={}{0:0.00}}" /><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedText}" Text="{Binding Message}" /></StackPanel></Border>
        </UniformGrid>
    </Grid>
</UserControl>
