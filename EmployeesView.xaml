<UserControl x:Class="GestionBibliotheque.EmployeesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Padding="14,7" Content="Nouvo anplwaye" Command="{Binding NewCommand}" /><TextBox Width="280" Padding="8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /><Button Margin="8,0,0,0" Padding="14,7" Content="Chèche" Command="{Binding SearchCommand}" /></DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Nimewo" Binding="{Binding EmployeeNumber}" Width="110" /><DataGridTextColumn Header="Non" Binding="{Binding FirstName}" Width="*" /><DataGridTextColumn Header="Siyati" Binding="{Binding LastName}" Width="*" /><DataGridTextColumn Header="Post" Binding="{Binding JobTitle}" Width="150" /><DataGridTextColumn Header="Kont" Binding="{Binding AccountSummary}" Width="180" /></DataGrid.Columns></DataGrid>
            <Border Grid.Column="2" Padding="18" BorderBrush="#D9D3C8" BorderThickness="1"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock FontSize="20" FontWeight="SemiBold" Text="Detay anplwaye" /><TextBlock Margin="0,16,0,4" Text="Nimewo anplwaye" /><TextBox Padding="7" Text="{Binding EmployeeNumber, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,12,0,4" Text="Non" /><TextBox Padding="7" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,12,0,4" Text="Siyati" /><TextBox Padding="7" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,12,0,4" Text="Post" /><TextBox Padding="7" Text="{Binding JobTitle, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,12,0,4" Text="Depatman" /><TextBox Padding="7" Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,12,0,4" Text="Dat anbochaj (AAAA-MM-JJ)" /><TextBox Padding="7" Text="{Binding HireDate, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,12,0,4" Text="Imèl" /><TextBox Padding="7" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,12,0,4" Text="Telefòn" /><TextBox Padding="7" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,12,0,4" Text="Kont" /><TextBlock Foreground="#657477" Text="{Binding AccountSummary}" TextWrapping="Wrap" /><TextBlock Margin="0,12,0,4" Text="Non itilizatè" /><TextBox Padding="7" Text="{Binding AccountUsername, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,8,0,4" Text="Modpas tanporè" /><PasswordBox Padding="7" PasswordChanged="AccountPasswordBox_Changed" /><TextBlock Margin="0,8,0,4" Text="Role" /><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name" /><Button Margin="0,8,0,0" Padding="14,8" Content="Kreye kont" Command="{Binding CreateAccountCommand}" /><Button Margin="0,8,0,0" Padding="14,8" Content="Reyajiste modpas kont" Command="{Binding ResetPasswordCommand}" /><StackPanel Margin="0,18,0,0" Orientation="Horizontal"><Button Padding="14,8" Content="Sove" Command="{Binding SaveCommand}" /><Button Margin="8,0,0,0" Padding="14,8" Content="Dezaktive" Command="{Binding DeactivateCommand}" /></StackPanel><TextBlock Margin="0,14,0,0" Foreground="#657477" Text="{Binding Message}" TextWrapping="Wrap" /></StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>
