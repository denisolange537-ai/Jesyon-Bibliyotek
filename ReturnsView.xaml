<UserControl x:Class="GestionBibliotheque.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <GroupBox Header="Borrowing ouvè" Margin="0,0,0,12">
            <DockPanel Margin="10"><Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="14,7" Content="Fè retou" Command="{Binding ReturnCommand}" />
                <DataGrid ItemsSource="{Binding OpenBorrowings}" SelectedItem="{Binding SelectedBorrowing}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns><DataGridTextColumn Header="Liv" Binding="{Binding BookTitle}" Width="*" /><DataGridTextColumn Header="Manm" Binding="{Binding MemberName}" Width="*" /><DataGridTextColumn Header="Due" Binding="{Binding DueAtUtc, StringFormat=d}" Width="120" /></DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="Amann ki poko peye">
            <DockPanel Margin="10"><StackPanel DockPanel.Dock="Right" Width="180" Margin="12,0,0,0"><TextBlock Text="Montan" /><TextBox Margin="0,5,0,8" Padding="7" Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" /><Button Padding="14,7" Content="Peye" Command="{Binding PayCommand}" /></StackPanel>
                <DataGrid ItemsSource="{Binding OutstandingFines}" SelectedItem="{Binding SelectedFine}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Liv" Binding="{Binding BookTitle}" Width="*" /><DataGridTextColumn Header="Manm" Binding="{Binding MemberName}" Width="*" /><DataGridTextColumn Header="Total" Binding="{Binding Amount, StringFormat={}{0:0.00}}" Width="90" /><DataGridTextColumn Header="Peye" Binding="{Binding PaidAmount, StringFormat={}{0:0.00}}" Width="90" /></DataGrid.Columns></DataGrid>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
